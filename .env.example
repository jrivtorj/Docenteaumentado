# Copia este archivo como .env y ajusta los valores. NO incluyas secretos:
# todas estas variables son públicas y acaban en el HTML generado.

# Dominio canónico, sin barra final. Si no se define, se usa https://eldocenteaumentado.com.
SITE_URL=https://eldocenteaumentado.com

# development | preview | staging | production. Solo "production" permite indexar.
SITE_ENV=development

# Formulario de contacto: URL a la que se envía el formulario (POST).
# Si no se define, se usa el endpoint de Formspree del proyecto.
PUBLIC_CONTACT_FORM_ACTION=https://formspree.io/f/xqpewezl
# Correo de contacto visible. Si no se define, se usa eldocenteaumentado@gmail.com.
PUBLIC_CONTACT_EMAIL=eldocenteaumentado@gmail.com

# Newsletter: URL "action" del formulario embebible del proveedor (Buttondown,
# MailerLite, Brevo…). Vacío = la suscripción se muestra como pendiente.
PUBLIC_NEWSLETTER_ACTION=
# Nombre del campo de correo que espera el proveedor (por defecto "email").
PUBLIC_NEWSLETTER_EMAIL_FIELD=email
# Nombre del proveedor, para la nota de privacidad del formulario (ej. "Buttondown").
PUBLIC_NEWSLETTER_PROVIDER=

# Analítica respetuosa con la privacidad (opcional, sin cookies): Plausible, Umami…
# URL del script y dominio/ID del sitio. Vacío = no se carga ninguna analítica.
PUBLIC_ANALYTICS_SCRIPT=
PUBLIC_ANALYTICS_DOMAIN=

# Código de verificación de Google Search Console (método etiqueta HTML), opcional.
PUBLIC_GSC_VERIFICATION=
