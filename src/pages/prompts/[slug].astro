---
import type { GetStaticPaths } from 'astro';
import { getEntries, getEntry, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Icono from '@/components/Icono.astro';
import TarjetaArticulo from '@/components/TarjetaArticulo.astro';
import TarjetaPrompt from '@/components/TarjetaPrompt.astro';
import { ETAPAS, TAREAS_DOCENTES } from '@/data/taxonomias';
import { getPrompts, urlHerramienta, urlPrompt, urlTema, type Prompt } from '@/utils/contenido';
import { fechaISO, fechaLarga } from '@/utils/fechas';
import { articulo as ld } from '@/utils/jsonld';
import { SITIO } from '@/data/sitio';

export const getStaticPaths = (async () => {
  const todos = await getPrompts();
  return todos.map((prompt) => ({ params: { slug: prompt.id }, props: { prompt, todos } }));
}) satisfies GetStaticPaths;

interface Props {
  prompt: Prompt;
  todos: Prompt[];
}
const { prompt, todos } = Astro.props;
const { data } = prompt;
const { Content } = await render(prompt);
const herramientas = await getEntries(data.herramientas);
const articulos = (await getEntries(data.relacionados)).filter((a) => a.data.estado === 'publicado' || import.meta.env.DEV);
const temas = await getEntries(data.temas);
const autor = await getEntry('autores', SITIO.autorPrincipal);
const otros = todos
  .filter((p) => p.id !== prompt.id && (p.data.tarea === data.tarea || p.data.etiquetas.some((e) => data.etiquetas.includes(e))))
  .slice(0, 3);

// Trocea el prompt para envolver cada [VARIABLE] en una marca editable.
const trozos = data.prompt.trim().split(/(\[[A-ZÁÉÍÓÚÑ0-9_]+\])/g);
const ruta = urlPrompt(prompt);
---

<Base
  titulo={data.seo.titulo ?? (data.titulo.length <= 55 ? `Prompt: ${data.titulo}` : data.titulo)}
  descripcion={data.seo.descripcion ?? data.descripcion}
  tipo="article"
  noindex={data.seo.noindex}
  publicado={data.fechaPublicacion}
  actualizado={data.fechaActualizacion}
  migas={[
    { nombre: 'Prompts', href: '/prompts/' },
    { nombre: data.titulo, href: ruta },
  ]}
  jsonLd={[
    ld({
      titulo: data.titulo,
      descripcion: data.descripcion,
      ruta,
      publicado: data.fechaPublicacion,
      actualizado: data.fechaActualizacion,
      autor: { nombre: autor!.data.nombre, url: autor!.data.url },
      tipo: 'TechArticle',
      site: Astro.site!,
      palabrasClave: data.etiquetas,
    }),
  ]}
>
  <article class="contenedor contenedor--texto">
    <header class="cabecera-pagina">
      <p class="antetitulo">Prompt · {TAREAS_DOCENTES[data.tarea]}</p>
      <h1>{data.titulo}</h1>
      <p class="entradilla">{data.descripcion}</p>
      <dl class="ficha">
        <div>
          <dt>Etapa</dt>
          <dd>{data.etapas.map((e) => ETAPAS[e]).join(', ')}</dd>
        </div>
        <div>
          <dt>Herramientas</dt>
          <dd>
            {data.generico && 'Cualquier asistente conversacional'}
            {data.generico && herramientas.length > 0 && '. Probado con: '}
            {
              herramientas.map((h, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={urlHerramienta(h)}>{h.data.nombre}</a>
                </>
              ))
            }
          </dd>
        </div>
        <div>
          <dt>Actualizado</dt>
          <dd>
            <time datetime={fechaISO(data.fechaActualizacion ?? data.fechaPublicacion)}>
              {fechaLarga(data.fechaActualizacion ?? data.fechaPublicacion)}
            </time>
          </dd>
        </div>
      </dl>
    </header>

    <section aria-labelledby="t-objetivo" class="bloque">
      <h2 id="t-objetivo">Objetivo</h2>
      <p>{data.finalidad}</p>
    </section>

    <section aria-labelledby="t-prompt" class="bloque" data-copiar-zona>
      <div class="bloque__cabecera">
        <h2 id="t-prompt">El prompt</h2>
        <button type="button" class="boton" data-copiar="#texto-prompt" hidden>
          <Icono nombre="copiar" />
          <span data-etiqueta>Copiar prompt</span>
        </button>
      </div>
      <p class="meta">Las palabras entre corchetes son variables: rellénalas abajo y se sustituirán en el texto antes de copiarlo.</p>
      <pre class="prompt" id="texto-prompt" tabindex="0" aria-label="Texto del prompt">{
        trozos.map((t) => {
          const m = t.match(/^\[([A-ZÁÉÍÓÚÑ0-9_]+)\]$/);
          return m ? <mark data-var={m[1]}>{t}</mark> : t;
        })
      }</pre>
      <p class="visualmente-oculto" data-copiar-estado aria-live="polite"></p>
    </section>

    <section aria-labelledby="t-variables" class="bloque">
      <h2 id="t-variables">Variables</h2>
      <div class="editor" data-editor-variables hidden>
        <p class="meta">Escribe tus datos; el prompt de arriba se actualiza en vivo. Nada sale de tu navegador.</p>
        {
          data.variables.map((v) => (
            <div class="campo">
              <label for={`var-${v.nombre}`}>
                <code>[{v.nombre}]</code> {v.descripcion}
              </label>
              <textarea
                id={`var-${v.nombre}`}
                class="entrada"
                rows="2"
                data-variable={v.nombre}
                data-ejemplo={v.ejemplo}
                placeholder={`Ej.: ${v.ejemplo}`}
              />
            </div>
          ))
        }
        <div class="editor__acciones" data-copiar-zona>
          <button type="button" class="boton" data-copiar="#texto-prompt" hidden>
            <Icono nombre="copiar" />
            <span data-etiqueta>Copiar prompt rellenado</span>
          </button>
          <button type="button" class="boton boton--secundario" data-rellenar-ejemplo>Rellenar con el ejemplo</button>
          <button type="button" class="boton boton--secundario" data-limpiar>Vaciar</button>
          <p class="visualmente-oculto" data-copiar-estado aria-live="polite"></p>
        </div>
      </div>
      <noscript>
        <dl class="lista-variables">
          {
            data.variables.map((v) => (
              <>
                <dt><code>[{v.nombre}]</code></dt>
                <dd>{v.descripcion} Ejemplo: «{v.ejemplo}».</dd>
              </>
            ))
          }
        </dl>
      </noscript>
    </section>

    <div class="prosa bloque">
      <Content />
    </div>

    {
      (temas.length > 0 || data.etiquetas.length > 0) && (
        <p class="etiquetas-prompt">
          {temas.map((t) => (
            <a class="etiqueta etiqueta--acento" href={urlTema(t.id)}>
              {t.data.nombre}
            </a>
          ))}
          {data.etiquetas.map((e) => (
            <a class="etiqueta" href={`/buscar/?q=${encodeURIComponent(e)}`} rel="nofollow">
              {e}
            </a>
          ))}
        </p>
      )
    }
  </article>

  {
    articulos.length > 0 && (
      <section class="contenedor relacionados" aria-labelledby="t-rel-art">
        <h2 id="t-rel-art">Para entender el contexto</h2>
        <div class="rejilla">
          {articulos.map((a) => (
            <TarjetaArticulo articulo={a} />
          ))}
        </div>
      </section>
    )
  }
  {
    otros.length > 0 && (
      <section class="contenedor relacionados" aria-labelledby="t-rel-p">
        <h2 id="t-rel-p">Prompts relacionados</h2>
        <div class="rejilla">
          {otros.map((p) => (
            <TarjetaPrompt prompt={p} />
          ))}
        </div>
      </section>
    )
  }
</Base>

<script>
  import '@/scripts/copiar';
  import '@/scripts/variables';
</script>

<style>
  .ficha {
    display: grid;
    gap: var(--e-2);
    margin-top: var(--e-5);
    font-size: var(--t-sm);
  }
  .ficha div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--e-3);
  }
  .ficha dt {
    color: var(--c-texto-3);
  }
  .bloque {
    margin-top: var(--e-6);
  }
  .bloque h2 {
    font-size: var(--t-xl);
    margin-bottom: var(--e-3);
  }
  .bloque__cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-3);
    margin-bottom: var(--e-2);
  }
  .bloque__cabecera h2 {
    margin: 0;
  }
  .prompt {
    margin-top: var(--e-3);
    font-family: var(--f-mono);
    font-size: 0.92rem;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-word;
    padding: var(--e-5);
    border: 1px solid var(--c-borde-fuerte);
    border-radius: var(--radio);
    background: var(--c-fondo-suave);
    max-height: 36rem;
    overflow: auto;
  }
  .prompt mark {
    background: var(--c-acento-suave);
    color: var(--c-acento);
    font-weight: 600;
    border-radius: 3px;
    padding: 0 0.15em;
  }
  .prompt mark[data-relleno='true'] {
    background: var(--c-ok-fondo);
    color: var(--c-ok);
  }
  [data-copiar][data-estado='copiado'] {
    background: var(--c-ok);
    border-color: var(--c-ok);
  }
  .editor {
    display: grid;
    gap: var(--e-4);
  }
  .editor[hidden] {
    display: none;
  }
  .editor textarea.entrada {
    min-height: 3rem;
  }
  .editor__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2);
  }
  .lista-variables dd {
    margin: 0 0 var(--e-3);
    color: var(--c-texto-2);
  }
  .etiquetas-prompt {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2);
    margin-top: var(--e-6);
  }
  .relacionados {
    margin-top: var(--e-8);
  }
  .relacionados h2 {
    font-size: var(--t-xl);
    margin-bottom: var(--e-4);
  }
</style>
