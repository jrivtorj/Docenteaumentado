---
import type { GetStaticPaths } from 'astro';
import { getEntry, getEntries, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Indice from '@/components/Indice.astro';
import Fuentes from '@/components/Fuentes.astro';
import CajaAutor from '@/components/CajaAutor.astro';
import TarjetaArticulo from '@/components/TarjetaArticulo.astro';
import TarjetaPrompt from '@/components/TarjetaPrompt.astro';
import { TIPOS_ARTICULO } from '@/data/taxonomias';
import { getArticulos, getPrompts, relacionados, tiempoLectura, urlArticulo, urlTema, type Articulo } from '@/utils/contenido';
import { fechaISO, fechaLarga } from '@/utils/fechas';
import { articulo as ldArticulo } from '@/utils/jsonld';

export const getStaticPaths = (async () => {
  const todos = await getArticulos();
  return todos.map((articulo) => ({ params: { slug: articulo.id }, props: { articulo, todos } }));
}) satisfies GetStaticPaths;

interface Props {
  articulo: Articulo;
  todos: Articulo[];
}
const { articulo, todos } = Astro.props;
const { data } = articulo;
const { Content, headings } = await render(articulo);
const autor = await getEntry(data.autor);
const temas = await getEntries(data.temas);
const tipo = TIPOS_ARTICULO[data.tipo];
const seccion = {
  guia: { nombre: 'IA en el aula', href: '/ia-en-el-aula/' },
  tutorial: { nombre: 'IA en el aula', href: '/ia-en-el-aula/' },
  opinion: { nombre: 'Opinión', href: '/opinion/' },
  actualidad: { nombre: 'Actualidad', href: '/actualidad/' },
  laboratorio: { nombre: 'Laboratorio', href: '/laboratorio/' },
  experiencia: { nombre: 'Desde mi aula', href: '/desde-mi-aula/' },
}[data.tipo];
const vecinos = relacionados(articulo, todos);
const prompts = (await getPrompts()).filter((p) => p.data.relacionados.some((r) => r.id === articulo.id)).slice(0, 3);
const ruta = urlArticulo(articulo);
const tipoSchema = data.tipo === 'opinion' ? 'OpinionNewsArticle' : data.tipo === 'tutorial' ? 'TechArticle' : 'Article';
---

<Base
  titulo={data.seo.titulo ?? data.titulo}
  descripcion={data.seo.descripcion ?? data.descripcion}
  tipo="article"
  noindex={data.seo.noindex || data.estado !== 'publicado'}
  publicado={data.fechaPublicacion}
  actualizado={data.fechaActualizacion}
  imagen={data.imagen ? { src: data.imagen.src.src, alt: data.imagen.alt, ancho: data.imagen.src.width, alto: data.imagen.src.height } : undefined}
  migas={[seccion, { nombre: data.titulo, href: ruta }]}
  jsonLd={[
    ldArticulo({
      titulo: data.titulo,
      descripcion: data.descripcion,
      ruta,
      publicado: data.fechaPublicacion,
      actualizado: data.fechaActualizacion,
      autor: { nombre: autor.data.nombre, url: autor.data.url },
      imagen: data.imagen?.src.src,
      tipo: tipoSchema,
      site: Astro.site!,
      palabrasClave: data.etiquetas,
    }),
  ]}
>
  <article class="contenedor contenedor--texto articulo">
    {
      data.estado !== 'publicado' && (
        <p class="aviso aviso--pendiente">
          <strong>Estado: {data.estado}.</strong> Solo visible en desarrollo; no se publicará hasta marcarlo como
          «publicado».
        </p>
      )
    }
    <header class="articulo__cabecera">
      <p class="antetitulo">{tipo.nombre}</p>
      <h1>{data.titulo}</h1>
      <p class="entradilla">{data.descripcion}</p>
      <p class="meta articulo__meta">
        Por <a href={autor.data.url}>{autor.data.nombre}</a>{' '}
        · Publicado el <time datetime={fechaISO(data.fechaPublicacion)}>{fechaLarga(data.fechaPublicacion)}</time>{' '}
        {
          data.fechaActualizacion && (
            <>
              · Actualizado el <time datetime={fechaISO(data.fechaActualizacion)}>{fechaLarga(data.fechaActualizacion)}</time>{' '}
            </>
          )
        }
        · {tiempoLectura(articulo)} min de lectura
      </p>
      {
        data.tipo === 'opinion' && (
          <p class="aviso articulo__aviso-opinion">
            Este es un <strong>artículo de opinión</strong>: expresa el criterio del autor. Los datos que se afirman como
            hechos están enlazados a su fuente.
          </p>
        )
      }
    </header>

    <Indice encabezados={headings} />

    <div class="prosa articulo__cuerpo">
      <Content />
    </div>

    <Fuentes fuentes={data.fuentes} />

    <footer class="articulo__pie">
      {
        temas.length > 0 && (
          <p class="articulo__temas">
            <span class="meta">Temas:</span>
            {temas.map((t) => (
              <a class="etiqueta etiqueta--acento" href={urlTema(t.id)}>
                {t.data.nombre}
              </a>
            ))}
          </p>
        )
      }
      <CajaAutor autor={autor} />
    </footer>
  </article>

  {
    prompts.length > 0 && (
      <section class="contenedor relacionados" aria-labelledby="t-prompts-rel">
        <h2 id="t-prompts-rel">Prompts para aplicar este artículo</h2>
        <div class="rejilla">
          {prompts.map((p) => (
            <TarjetaPrompt prompt={p} />
          ))}
        </div>
      </section>
    )
  }

  {
    vecinos.length > 0 && (
      <section class="contenedor relacionados" aria-labelledby="t-relacionados">
        <h2 id="t-relacionados">Sigue leyendo</h2>
        <div class="rejilla">
          {vecinos.map((a) => (
            <TarjetaArticulo articulo={a} />
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .articulo__cabecera {
    padding-block: var(--e-5) var(--e-5);
  }
  .articulo__cabecera h1 {
    margin-top: var(--e-2);
  }
  .articulo__cabecera .entradilla {
    margin-top: var(--e-4);
  }
  .articulo__meta {
    margin-top: var(--e-4);
  }
  .articulo__aviso-opinion {
    margin-top: var(--e-4);
  }
  .articulo__cuerpo {
    margin-top: var(--e-6);
  }
  .articulo__pie {
    margin-top: var(--e-6);
  }
  .articulo__temas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-2);
  }
  .relacionados {
    margin-top: var(--e-8);
  }
  .relacionados h2 {
    font-size: var(--t-xl);
    margin-bottom: var(--e-4);
  }
</style>
