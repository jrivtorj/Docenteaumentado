---
import Base from '@/layouts/Base.astro';
import { NAV_PRINCIPAL } from '@/data/sitio';
---

<Base titulo="Página no encontrada" descripcion="La página que buscas no existe o ha cambiado de dirección." noindex>
  <div class="contenedor contenedor--texto error">
    <p class="antetitulo">Error 404</p>
    <h1>Esta página no existe (o ya no está aquí)</h1>
    <p class="entradilla">
      Puede que el enlace esté mal escrito o que el contenido haya cambiado de dirección. Prueba a buscarlo:
    </p>
    <form action="/buscar/" method="get" role="search" class="error__busqueda">
      <label for="q404" class="visualmente-oculto">Buscar</label>
      <input id="q404" name="q" type="search" class="entrada" placeholder="¿Qué buscabas?" />
      <button class="boton" type="submit">Buscar</button>
    </form>
    <h2>O ve directamente a</h2>
    <ul>
      <li><a href="/">Página de inicio</a></li>
      {NAV_PRINCIPAL.map((e) => <li><a href={e.href}>{e.texto}</a></li>)}
    </ul>
  </div>
</Base>

<style>
  .error {
    padding-block: var(--e-7);
  }
  .error h1 {
    margin-block: var(--e-2) var(--e-4);
  }
  .error__busqueda {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2);
    margin-block: var(--e-5) var(--e-6);
  }
  .error__busqueda .entrada {
    flex: 1 1 14rem;
  }
  h2 {
    font-size: var(--t-lg);
    margin-bottom: var(--e-3);
  }
  ul {
    padding-left: 1.2em;
    display: grid;
    gap: var(--e-2);
  }
</style>
