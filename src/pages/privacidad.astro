---
import Pagina from '@/layouts/Pagina.astro';
import { SITIO } from '@/data/sitio';
import { getEntry } from 'astro:content';
import {
  PUBLIC_CONTACT_EMAIL,
  PUBLIC_CONTACT_FORM_ACTION,
  PUBLIC_NEWSLETTER_ACTION,
  PUBLIC_NEWSLETTER_PROVIDER,
  PUBLIC_ANALYTICS_SCRIPT,
  PUBLIC_GA_ID,
} from 'astro:env/server';
/*
 * Información del art. 13 del RGPD. Las filas de formulario, newsletter y analítica se
 * adaptan solas a las variables de entorno: lo que no está activo se declara como tal.
 * Revísala cada vez que se active un servicio nuevo. No es asesoramiento jurídico.
 */
const autor = (await getEntry('autores', SITIO.autorPrincipal))!;
const dominio = (url?: string) => {
  try {
    return url ? new URL(url).hostname : undefined;
  } catch {
    return undefined;
  }
};
// Proveedores de formularios conocidos: nombre, ubicación y garantía de la transferencia.
// Fuente de Formspree: https://formspree.io/security/ (consultada el 15/10/2026).
const PROVEEDORES: Record<string, { nombre: string; garantia: string }> = {
  'formspree.io': {
    nombre: 'Formspree, Inc. (Estados Unidos; servidores de Amazon Web Services en EE. UU.)',
    garantia: 'Formspree declara amparar las transferencias en las cláusulas contractuales tipo de la Comisión Europea.',
  },
};
const dominioFormulario = dominio(PUBLIC_CONTACT_FORM_ACTION);
const proveedorFormulario = dominioFormulario ? PROVEEDORES[dominioFormulario] : undefined;
const servicioFormulario = proveedorFormulario?.nombre ?? dominioFormulario;
const correoGmail = PUBLIC_CONTACT_EMAIL?.toLowerCase().endsWith('@gmail.com');
const servicioNewsletter = PUBLIC_NEWSLETTER_PROVIDER ?? dominio(PUBLIC_NEWSLETTER_ACTION);
const servicioAnalitica = dominio(PUBLIC_ANALYTICS_SCRIPT);
const hayGA = Boolean(PUBLIC_GA_ID && /^G-[A-Z0-9]+$/.test(PUBLIC_GA_ID));
const hayFormularios = Boolean(PUBLIC_CONTACT_FORM_ACTION || PUBLIC_NEWSLETTER_ACTION);
---

<Pagina
  titulo="Política de privacidad"
  descripcion={`Cómo trata ${SITIO.nombre} los datos personales: responsable, finalidades, base jurídica, destinatarios, plazos y derechos.`}
  ruta="/privacidad/"
  actualizado={new Date(hayGA ? '2026-10-28' : '2026-10-24')}
  noindex
>
  <h2>Principio general: mínimos datos</h2>
  <p>
    {
      hayGA ? (
        <>
          Este sitio se ha diseñado para recoger los mínimos datos personales: no requiere registro y no carga servicios
          de terceros al visitar las páginas salvo Google Analytics, y solo si usted lo acepta en el aviso de cookies.
          Fuera de eso, solo se tratan datos cuando usted decide escribir por el formulario de contacto, el de solicitud
          de formación o el de colaboración, o suscribirse a la newsletter.
        </>
      ) : (
        <>
          Este sitio se ha diseñado para funcionar sin recoger datos personales: no requiere registro, no usa cookies y no
          carga servicios de terceros al visitar las páginas. Solo se tratan datos cuando usted decide escribir por el
          formulario de contacto, el de solicitud de formación o el de colaboración, o suscribirse a la newsletter.
        </>
      )
    }
    {!hayFormularios && <>{' '}En este momento ninguno de los formularios está activo, así que el sitio no recoge datos personales.</>}
  </p>

  <h2>Responsable del tratamiento</h2>
  <ul>
    <li>Responsable: {autor.data.nombre}</li>
    <li>
      Contacto para asuntos de privacidad:
      {
        PUBLIC_CONTACT_EMAIL ? (
          <a href={`mailto:${PUBLIC_CONTACT_EMAIL}`}>{PUBLIC_CONTACT_EMAIL}</a>
        ) : (
          <a href="/contacto/">página de contacto</a>
        )
      }
    </li>
  </ul>

  <h2>Qué datos se tratan, para qué y con qué base jurídica</h2>
  <table>
    <thead>
      <tr><th>Tratamiento</th><th>Datos</th><th>Finalidad</th><th>Base jurídica</th><th>Conservación</th></tr>
    </thead>
    <tbody>
      <tr>
        <td>Formulario de contacto</td>
        <td>Nombre, correo y mensaje</td>
        <td>Responder a su consulta</td>
        <td>Consentimiento (art. 6.1.a RGPD)</td>
        <td>El tiempo necesario para atender la consulta y, como máximo, 12 meses</td>
      </tr>
      <tr>
        <td>Solicitud de formación</td>
        <td>Nombre, correo, centro, función y mensaje</td>
        <td>Responder a la solicitud y preparar una propuesta de formación</td>
        <td>Aplicación de medidas precontractuales a petición de la persona interesada (art. 6.1.b RGPD)</td>
        <td>El tiempo necesario para atender la solicitud y, si no se contrata, como máximo 12 meses</td>
      </tr>
      <tr>
        <td>Propuesta de colaboración</td>
        <td>Nombre, correo, perfil, enlace profesional si se facilita y mensaje</td>
        <td>Responder a la propuesta, enviar el dossier del proyecto y valorar la colaboración</td>
        <td>Consentimiento (art. 6.1.a RGPD)</td>
        <td>El tiempo necesario para valorar la propuesta y, si no hay colaboración, como máximo 12 meses</td>
      </tr>
      <tr>
        <td>Newsletter</td>
        <td>Correo electrónico</td>
        <td>Enviar la newsletter</td>
        <td>Consentimiento (art. 6.1.a RGPD)</td>
        <td>Hasta que se dé de baja</td>
      </tr>
      {
        hayGA ? (
          <tr>
            <td>Estadísticas de uso (Google Analytics)</td>
            <td>
              Identificador aleatorio de la cookie, páginas visitadas, procedencia de la visita, tipo de dispositivo y
              navegador, y ubicación aproximada (país o ciudad). Google Analytics 4 no registra ni almacena la dirección IP.
            </td>
            <td>Conocer de forma estadística qué contenidos resultan útiles. Sin fines publicitarios</td>
            <td>Consentimiento (art. 6.1.a RGPD y art. 22.2 LSSI-CE), que puede retirar en cualquier momento desde «Configurar cookies»</td>
            <td>Los datos asociados a cada visitante se conservan 2 meses en Google Analytics; los informes agregados, de forma indefinida</td>
          </tr>
        ) : (
          <tr>
            <td>Estadísticas de uso</td>
            <td>{PUBLIC_ANALYTICS_SCRIPT ? 'Datos agregados y anónimos de navegación, sin cookies' : 'Ninguno: actualmente no hay analítica activa'}</td>
            <td>Conocer qué contenidos resultan útiles</td>
            <td>{PUBLIC_ANALYTICS_SCRIPT ? 'Interés legítimo (art. 6.1.f RGPD)' : 'No aplica'}</td>
            <td>{PUBLIC_ANALYTICS_SCRIPT ? `Según la política de ${servicioAnalitica ?? 'su proveedor'}` : 'No aplica'}</td>
          </tr>
        )
      }
    </tbody>
  </table>

  <h2>Destinatarios y encargados del tratamiento</h2>
  <p>No se ceden datos a terceros salvo obligación legal. Para prestar el servicio intervienen como encargados:</p>
  <ul>
    <li>
      Alojamiento web: Cloudflare, Inc. (Estados Unidos). Como cualquier servidor, registra datos técnicos de conexión,
      como la dirección IP, por motivos de seguridad y funcionamiento.
    </li>
    <li>
      Formularios de contacto, de solicitud de formación y de colaboración: {servicioFormulario ?? 'ninguno; no están activos'}.
      {servicioFormulario && <>{' '}El mensaje se reenvía al correo de contacto.</>}
    </li>
    {correoGmail && <li>Correo de contacto: Google (servicio Gmail), que aloja los mensajes recibidos.</li>}
    {
      hayGA && (
        <li>
          Estadísticas de uso, solo con su consentimiento: Google Ireland Limited (servicio Google Analytics). Más detalle en
          la <a href="/cookies/">política de cookies</a>.
        </li>
      )
    }
    <li>Newsletter: {servicioNewsletter ?? 'ninguno; la suscripción no está activa'}.</li>
  </ul>
  <p>
    Cloudflare realiza transferencias internacionales de datos amparadas en su certificación en el Marco de Privacidad de
    Datos UE-EE. UU. y, subsidiariamente, en las cláusulas contractuales tipo de la Comisión Europea.
    {(correoGmail || hayGA) && <>{' '}Google puede transferir datos a Google LLC (Estados Unidos), certificada en el mismo Marco de Privacidad de Datos UE-EE. UU.</>}
    {proveedorFormulario && <>{' '}{proveedorFormulario.garantia}</>}
    {
      (!proveedorFormulario || !PUBLIC_NEWSLETTER_ACTION) && (
        <>{' '}Cuando se active otro servicio de formularios o de newsletter, se indicará aquí su ubicación y la garantía que aplique.</>
      )
    }
  </p>

  <h2>Sus derechos</h2>
  <p>
    Puede ejercer los derechos de acceso, rectificación, supresión, oposición, limitación del tratamiento y portabilidad,
    así como retirar su consentimiento en cualquier momento, escribiendo al contacto indicado. Si considera que sus datos
    no se tratan correctamente, puede presentar una reclamación ante la
    <a href="https://www.aepd.es/" rel="noopener">Agencia Española de Protección de Datos</a>.
  </p>

  <h2>Menores de edad</h2>
  <p>
    Este sitio se dirige a profesionales de la educación. Los formularios no están pensados para menores de 14 años,
    edad mínima para consentir el tratamiento de datos según el artículo 7 de la Ley Orgánica 3/2018 (LOPDGDD).
  </p>
</Pagina>
