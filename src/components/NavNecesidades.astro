---
/**
 * Segundo nivel de navegación: acceso transversal por necesidades docentes.
 * No sustituye al menú principal (organizado por tipo de contenido).
 */
import { NECESIDADES_DOCENTES } from '@/data/taxonomias';
import { urlNecesidad } from '@/utils/contenido';

const ruta = Astro.url.pathname;
const necesidades = Object.entries(NECESIDADES_DOCENTES);
---

<nav class="nav-necesidades" aria-labelledby="nav-necesidades-titulo">
  <div class="contenedor nav-necesidades__fila">
    <a id="nav-necesidades-titulo" class="nav-necesidades__titulo" href="/necesidades/" aria-current={ruta === '/necesidades/' ? 'page' : undefined}>
      Por necesidad docente
    </a>
    <ul>
      {
        necesidades.map(([id, n]) => (
          <li>
            <a href={urlNecesidad(id)} aria-current={ruta === urlNecesidad(id) ? 'page' : undefined}>
              {n.nombre}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  .nav-necesidades {
    background: var(--c-fondo-suave);
    border-bottom: 1px solid var(--c-borde);
    font-size: var(--t-xs);
  }
  .nav-necesidades__fila {
    display: flex;
    align-items: center;
    gap: var(--e-2) var(--e-4);
    /* En pantallas estrechas la fila se desplaza en horizontal dentro de su caja;
       la página no desborda. */
    overflow-x: auto;
    scrollbar-width: thin;
    white-space: nowrap;
  }
  .nav-necesidades__titulo {
    flex: none;
    font-weight: 700;
    color: var(--c-texto);
    text-decoration: none;
    padding-block: var(--e-2);
    padding-right: var(--e-4);
    border-right: 1px solid var(--c-borde);
  }
  ul {
    display: flex;
    gap: var(--e-1) var(--e-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  ul a {
    display: inline-block;
    padding-block: var(--e-2);
    color: var(--c-texto-2);
    font-weight: 500;
    text-decoration: none;
  }
  a:hover,
  a[aria-current='page'] {
    color: var(--c-acento);
  }
  a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }
</style>
