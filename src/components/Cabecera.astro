---
import { NAV_PRINCIPAL, SITIO } from '@/data/sitio';
import Icono from './Icono.astro';

const ruta = Astro.url.pathname;
const activo = (href: string) => ruta === href || (href !== '/' && ruta.startsWith(href));
---

<header role="banner" class="cabecera">
  <div class="contenedor cabecera__fila">
    <a href="/" class="marca" aria-label={`${SITIO.nombre}, ir a la página de inicio`}>
      <svg class="marca__logo" viewBox="0 0 64 64" width="32" height="32" aria-hidden="true" focusable="false">
        <rect width="64" height="64" rx="14" fill="#0b5f70"></rect>
        <text x="32" y="44" text-anchor="middle" fill="#fff">da</text>
        <circle cx="49" cy="17" r="5" fill="#9fe0ea"></circle>
      </svg>
      <span class="marca__el">El docente</span><span class="marca__aum">aumentado</span>
    </a>

    <div class="cabecera__acciones">
      <a href="/buscar/" class="boton-icono" aria-label="Buscar en el sitio">
        <Icono nombre="buscar" />
      </a>
      <button
        type="button"
        class="boton-icono menu-boton"
        aria-expanded="false"
        aria-controls="nav-principal"
        data-menu-boton
      >
        <Icono nombre="menu" class="menu-boton__abrir" />
        <Icono nombre="cerrar" class="menu-boton__cerrar" />
        <span class="visualmente-oculto">Menú</span>
      </button>
    </div>

    <nav id="nav-principal" class="nav" aria-label="Principal" data-menu>
      <ul>
        {
          NAV_PRINCIPAL.map((e) => (
            <li>
              <a href={e.href} aria-current={activo(e.href) ? 'page' : undefined}>
                {e.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // Mejora progresiva: sin JS (sin clase .js en <html>) el menú se muestra desplegado
  // y el botón no aparece. Con JS, el CSS lo pliega en móvil desde el primer pintado.
  const boton = document.querySelector<HTMLButtonElement>('[data-menu-boton]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (boton && menu) {
    const cerrar = () => {
      boton.setAttribute('aria-expanded', 'false');
      menu.dataset.abierto = 'false';
    };
    boton.addEventListener('click', () => {
      const abierto = boton.getAttribute('aria-expanded') === 'true';
      boton.setAttribute('aria-expanded', String(!abierto));
      menu.dataset.abierto = String(!abierto);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && boton.getAttribute('aria-expanded') === 'true') {
        cerrar();
        boton.focus();
      }
    });
    window.matchMedia('(min-width: 64rem)').addEventListener('change', cerrar);
  }
</script>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--c-fondo) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(8px);
    border-bottom: 1px solid var(--c-borde);
  }
  .cabecera__fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-2) var(--e-5);
    min-height: 4rem;
  }
  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-family: var(--f-serif);
    font-size: 1.3rem;
    letter-spacing: -0.01em;
    color: var(--c-texto);
    text-decoration: none;
    padding-block: var(--e-2);
  }
  /* Isotipo: el mismo dibujo que public/favicon.svg, con la tipografía de la web. */
  .marca__logo {
    flex: none;
    margin-right: 0.2em;
  }
  .marca__logo text {
    font-family: var(--f-serif);
    font-size: 31px;
    font-weight: 700;
  }
  .marca__el {
    font-weight: 500;
  }
  .marca__aum {
    font-weight: 700;
    color: var(--c-acento);
  }
  .marca:hover {
    color: var(--c-texto);
  }
  .cabecera__acciones {
    display: flex;
    gap: var(--e-1);
    order: 2;
  }
  .boton-icono {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radio-sm);
    border: 1px solid transparent;
    background: none;
    color: var(--c-texto);
    cursor: pointer;
  }
  .boton-icono:hover {
    background: var(--c-fondo-suave);
    color: var(--c-acento);
  }
  .menu-boton {
    display: none;
  }
  /* En móvil, marca más compacta para que quepa en la misma fila que los botones. */
  @media (max-width: 63.99rem) {
    .cabecera__fila {
      column-gap: var(--e-2);
    }
    .marca {
      font-size: clamp(0.9rem, 4.2vw, 1.3rem);
    }
    .marca__logo {
      width: 1.5em;
      height: 1.5em;
    }
  }
  @media (max-width: 63.99rem) {
    :global(.js) .menu-boton {
      display: inline-grid;
    }
    :global(.js) .nav:not([data-abierto='true']) {
      display: none;
    }
    :global(.js) .nav ul {
      flex-direction: column;
      gap: 0;
    }
    :global(.js) .nav a {
      display: block;
      padding: var(--e-3) 0;
      border-top: 1px solid var(--c-borde);
    }
  }
  .menu-boton :global(.menu-boton__cerrar),
  .menu-boton[aria-expanded='true'] :global(.menu-boton__abrir) {
    display: none;
  }
  .menu-boton[aria-expanded='true'] :global(.menu-boton__cerrar) {
    display: block;
  }
  .nav {
    order: 3;
    flex-basis: 100%;
  }
  .nav ul {
    list-style: none;
    padding: 0 0 var(--e-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-1) var(--e-4);
  }
  .nav a {
    color: var(--c-texto-2);
    text-decoration: none;
    font-size: var(--t-sm);
    font-weight: 550;
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--c-acento);
  }
  .nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }
  @media (min-width: 64rem) {
    .nav {
      order: 1;
      flex-basis: auto;
      margin-left: auto;
    }
    .nav ul {
      padding: 0;
      gap: var(--e-4);
    }
    .cabecera__acciones {
      order: 2;
    }
  }
  /* Hasta que caben marca, menú y buscador en una sola fila, la marca ocupa la primera
     y el menú baja con el buscador, para que el buscador nunca quede solo en otra línea. */
  @media (min-width: 64rem) and (max-width: 84.99rem) {
    .marca {
      flex-basis: 100%;
    }
  }
  /* En una sola fila el ancho va muy justo con el isotipo: se estrechan los huecos. */
  @media (min-width: 85rem) {
    .cabecera__fila {
      column-gap: var(--e-4);
    }
    .nav ul {
      gap: var(--e-3);
    }
  }
</style>
