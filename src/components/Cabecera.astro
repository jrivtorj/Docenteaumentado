---
import { NAV_PRINCIPAL, SITIO } from '@/data/sitio';
import Icono from './Icono.astro';

const ruta = Astro.url.pathname;
const activo = (href: string) => ruta === href || (href !== '/' && ruta.startsWith(href));
---

<header role="banner" class="cabecera">
  <div class="contenedor cabecera__fila">
    <a href="/" class="marca" aria-label={`${SITIO.nombre}, ir a la página de inicio`}>
      <!-- Símbolo del manual de identidad: hexágono (estructura de conocimiento) con un cubo
           (capacidad que se amplía). Mismo dibujo que docs/identidad/simbolo-maestro.svg.
           Versión principal (petróleo + menta) y, en modo oscuro, inversa color (blanco + menta). -->
      <svg class="marca__logo" viewBox="0 0 64 64" width="36" height="36" aria-hidden="true" focusable="false">
        <path class="marca__hexagono" d="M32 4 56.25 18v28L32 60 7.75 46V18Z"></path>
        <path class="marca__cubo" d="M32 19 43.26 25.5v13L32 45 20.74 38.5V25.5Z M20.74 25.5 32 32 43.26 25.5 M32 32v13"></path>
      </svg>
      <span class="marca__texto"><span>El docente</span> <span>aumentado</span></span>
    </a>

    <div class="cabecera__acciones">
      <a href="/buscar/" class="boton-icono" aria-label="Buscar en el sitio">
        <Icono nombre="buscar" />
      </a>
      <button
        type="button"
        class="boton-icono menu-boton"
        aria-expanded="false"
        aria-controls="nav-principal"
        data-menu-boton
      >
        <Icono nombre="menu" class="menu-boton__abrir" />
        <Icono nombre="cerrar" class="menu-boton__cerrar" />
        <span class="visualmente-oculto">Menú</span>
      </button>
    </div>

    <nav id="nav-principal" class="nav" aria-label="Principal" data-menu>
      <ul>
        {
          NAV_PRINCIPAL.map((e) => (
            <li>
              <a href={e.href} aria-current={activo(e.href) ? 'page' : undefined}>
                {e.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // Mejora progresiva: sin JS (sin clase .js en <html>) el menú se muestra desplegado
  // y el botón no aparece. Con JS, el CSS lo pliega en móvil desde el primer pintado.
  const boton = document.querySelector<HTMLButtonElement>('[data-menu-boton]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (boton && menu) {
    const cerrar = () => {
      boton.setAttribute('aria-expanded', 'false');
      menu.dataset.abierto = 'false';
    };
    boton.addEventListener('click', () => {
      const abierto = boton.getAttribute('aria-expanded') === 'true';
      boton.setAttribute('aria-expanded', String(!abierto));
      menu.dataset.abierto = String(!abierto);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && boton.getAttribute('aria-expanded') === 'true') {
        cerrar();
        boton.focus();
      }
    });
    window.matchMedia('(min-width: 64rem)').addEventListener('change', cerrar);
  }
</script>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--c-fondo) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(8px);
    border-bottom: 1px solid var(--c-borde);
  }
  .cabecera__fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-2) var(--e-5);
    min-height: 4rem;
  }
  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--c-texto);
    text-decoration: none;
    padding-block: var(--e-2);
  }
  .marca__logo {
    flex: none;
    fill: none;
    stroke-width: 3.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .marca__hexagono {
    stroke: var(--c-logo-marco);
  }
  .marca__cubo {
    stroke: var(--c-menta);
  }
  /* Nombre en dos líneas y en mayúsculas, como en el manual. El texto real sigue en minúsculas
     («El docente aumentado») para lectores de pantalla y buscadores. */
  .marca__texto {
    display: flex;
    flex-direction: column;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .marca:hover {
    color: var(--c-texto);
  }
  .cabecera__acciones {
    display: flex;
    gap: var(--e-1);
    order: 2;
  }
  .boton-icono {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radio-sm);
    border: 1px solid transparent;
    background: none;
    color: var(--c-texto);
    cursor: pointer;
  }
  .boton-icono:hover {
    background: var(--c-fondo-suave);
    color: var(--c-acento);
  }
  .menu-boton {
    display: none;
  }
  /* En móvil, marca más compacta para que quepa en la misma fila que los botones. */
  @media (max-width: 63.99rem) {
    .cabecera__fila {
      column-gap: var(--e-2);
    }
    .marca__logo {
      width: 2rem;
      height: 2rem;
    }
  }
  @media (max-width: 63.99rem) {
    :global(.js) .menu-boton {
      display: inline-grid;
    }
    :global(.js) .nav:not([data-abierto='true']) {
      display: none;
    }
    :global(.js) .nav ul {
      flex-direction: column;
      gap: 0;
    }
    :global(.js) .nav a {
      display: block;
      padding: var(--e-3) 0;
      border-top: 1px solid var(--c-borde);
    }
  }
  .menu-boton :global(.menu-boton__cerrar),
  .menu-boton[aria-expanded='true'] :global(.menu-boton__abrir) {
    display: none;
  }
  .menu-boton[aria-expanded='true'] :global(.menu-boton__cerrar) {
    display: block;
  }
  .nav {
    order: 3;
    flex-basis: 100%;
  }
  .nav ul {
    list-style: none;
    padding: 0 0 var(--e-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-1) var(--e-4);
  }
  .nav a {
    color: var(--c-texto-2);
    text-decoration: none;
    font-size: var(--t-sm);
    font-weight: 500;
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--c-acento);
  }
  .nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }
  @media (min-width: 64rem) {
    .nav {
      order: 1;
      flex-basis: auto;
      margin-left: auto;
    }
    .nav ul {
      padding: 0;
      gap: var(--e-4);
    }
    .cabecera__acciones {
      order: 2;
    }
  }
  /* Hasta que caben marca, menú y buscador en una sola fila, la marca ocupa la primera
     y el menú baja con el buscador, para que el buscador nunca quede solo en otra línea. */
  @media (min-width: 64rem) and (max-width: 84.99rem) {
    .marca {
      flex-basis: 100%;
    }
  }
</style>
