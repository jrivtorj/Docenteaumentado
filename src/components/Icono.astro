  documento: '<path d="M7 3.5h7l4 4V20.5H7Z"/><path d="M14 3.5v4h4"/><circle cx="11.5" cy="13.5" r="2.5"/><path d="m13.4 15.4 2.1 2.1"/>',
  pantalla: '<rect x="3.5" y="4.5" width="17" height="11" rx="1.5"/><path d="M12 15.5V19M8 20h8"/><path d="M7.5 12l3-3 2 2 3.5-3.5"/>',
  imagen: '<rect x="3.5" y="4.5" width="17" height="15" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="m4 17.5 5-5 4 4 2.5-2.5 4.5 4.5"/>',
  reproducir: '<rect x="3.5" y="5" width="17" height="14" rx="2"/><path d="m10 9 5 3-5 3V9Z"/>',
  lista: '<path d="m4.5 7 1.5 1.5L9 5.5M4.5 13.5 6 15l3-3"/><path d="M12 7.5h7.5M12 14h7.5M5 19.5h14.5"/>',
  cursor: '<path d="m6 4 12 6.5-5.2 1.4L10.5 17 6 4Z"/><path d="m13 12.5 4.5 5"/>',
  engranaje: '<circle cx="12" cy="12" r="3"/><path d="M12 3.5v2.2M12 18.3v2.2M3.5 12h2.2M18.3 12h2.2M6 6l1.6 1.6M16.4 16.4 18 18M6 18l1.6-1.6M16.4 7.6 18 6"/>',
} as const;

interface Props {
  nombre: keyof typeof trazos;
  tamano?: number;
  etiqueta?: string;
  class?: string;
}
const { nombre, tamano = 20, etiqueta, class: clase } = Astro.props;
---

<svg
  class={clase}
  width={tamano}
  height={tamano}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={etiqueta ? undefined : 'true'}
  role={etiqueta ? 'img' : undefined}
  aria-label={etiqueta}
  focusable="false"
  set:html={trazos[nombre]}
/>
