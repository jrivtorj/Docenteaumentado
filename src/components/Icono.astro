---
/**
 * Iconos de trazo propio (24×24, stroke 1.75). Decorativos por defecto (aria-hidden).
 * Si el icono es el único contenido de un control, pasa `etiqueta`.
 */
const trazos = {
  buscar: '<circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/>',
  copiar: '<rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/>',
  ok: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  cerrar: '<path d="M6 6l12 12M18 6 6 18"/>',
  flecha: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  externo: '<path d="M14 5h5v5M19 5l-8 8"/><path d="M18 14v4a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4"/>',
  rss: '<path d="M5 5a14 14 0 0 1 14 14M5 11a8 8 0 0 1 8 8"/><circle cx="6" cy="18" r="1.2"/>',
  aula: '<path d="M3 9l9-5 9 5-9 5-9-5Z"/><path d="M7 11.5V16c0 1.4 2.2 3 5 3s5-1.6 5-3v-4.5"/>',
  prompt: '<path d="M5 6h14v10H9l-4 3V6Z"/><path d="M9 10h6M9 13h3"/>',
  herramienta: '<path d="M14.5 5.5a3.5 3.5 0 0 0 4 4.9l-8.8 8.8a1.8 1.8 0 0 1-2.6-2.6l8.8-8.8a3.5 3.5 0 0 0-1.4-2.3Z"/>',
  matraz: '<path d="M9 4h6M10 4v5.5L5 18a1.5 1.5 0 0 0 1.3 2h11.4A1.5 1.5 0 0 0 19 18l-5-8.5V4"/><path d="M7.5 14h9"/>',
  opinion: '<path d="M4 5h16v11H8l-4 4V5Z"/>',
  correo: '<rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="m4 7 8 6 8-6"/>',
  calendario: '<rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/>',
  reloj: '<circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/>',
  filtro: '<path d="M4 6h16M7 12h10M10 18h4"/>',
  // Pictogramas de categoría de herramienta (propios, sin marcas de terceros).
